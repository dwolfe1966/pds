{
  "manifest_version": 3,
  "name": "IDLookup Remove — opt-out assistant",
  "version": "1.0.0",
  "description": "Autofills data-broker opt-out forms, tracks each removal, and flags privacy risks as you browse — in your own browser.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_permissions": ["history"],
  "host_permissions": [
    "https://www.idlookup.ai/*",
    "https://idlookup.me/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IDLookup Remove",
    "default_icon": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "icons": { "16": "icon16.png", "32": "icon32.png", "48": "icon48.png", "128": "icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.idlookup.ai/*", "https://idlookup.ai/*", "https://idlookup.me/*"],
      "js": ["identity-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.spokeo.com/*",
        "https://*.whitepages.com/*",
        "https://*.beenverified.com/*",
        "https://*.peoplefinders.com/*",
        "https://*.radaris.com/*",
        "https://*.truepeoplesearch.com/*",
        "https://*.fastpeoplesearch.com/*",
        "https://*.instantcheckmate.com/*",
        "https://*.truthfinder.com/*",
        "https://*.intelius.com/*",
        "https://*.peopleconnect.us/*",
        "https://*.ussearch.com/*",
        "https://*.peekyou.com/*",
        "https://*.nuwber.com/*",
        "https://*.checkpeople.com/*",
        "https://*.clustrmaps.com/*",
        "https://*.searchpeoplefree.com/*",
        "https://*.advancedbackgroundchecks.com/*",
        "https://*.cyberbackgroundchecks.com/*",
        "https://*.usphonebook.com/*",
        "https://*.thatsthem.com/*",
        "https://*.safegraph.com/*",
        "https://*.mylife.com/*",
        "https://*.linkedin.com/*",
        "https://*.facebook.com/*",
        "https://*.instagram.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "https://*.tiktok.com/*",
        "https://*.reddit.com/*"
      ],
      "js": ["recipes.js", "signals.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
