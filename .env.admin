# ============================================================
# ADMIN APP — deployed to dev.admin.www.bytecrtrs.com/csr
# ============================================================

# ByteCrtrs API — relative /api so the build is host-agnostic and CORS-free.
# The deploy host (dev.admin.www.bytecrtrs.com) serves /api on the same origin.
# Don't hardcode the absolute host: the cert at dev.www.bytecrtrs.com only covers
# dev.admin.www.bytecrtrs.com (its CN) and dev.gwhubadmin.www.bytecrtrs.com (SAN);
# using the wrong absolute hostname produces ERR_CERT_COMMON_NAME_INVALID in the browser.
REACT_APP_NEW_API_ENABLED=true
REACT_APP_NEW_API_URL=/api
# BC's password.v0 captcha challenge cannot be auto-solved client-side
# without exposing the dev password in the public bundle. Leave empty in
# committed prod env. If a developer needs autofill while debugging,
# set REACT_APP_NEW_API_CAPTCHA in an untracked .env.admin.local file.
REACT_APP_NEW_API_CAPTCHA=

# Proxy — DISABLED (admin app is on the same domain as BC API)
REACT_APP_USE_API_PROXY=false
REACT_APP_PROXY_URL=

# Mock API — DISABLED
REACT_APP_USE_MOCK_API=false
REACT_APP_API_URL=

# Feature Flags — all use new API
REACT_APP_USE_NEW_API_SEARCH=true
REACT_APP_USE_NEW_API_REPORTS=true
REACT_APP_USE_NEW_API_OPTOUT=true
REACT_APP_USE_NEW_API_AUTH=true

# Admin emails
REACT_APP_ADMIN_EMAILS=admin@admin.admin

# Tracking API
# REACT_APP_TRACKING_API_URL=https://your-tracking-service.com
# REACT_APP_TRACKING_ADMIN_KEY=
