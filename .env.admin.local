# ============================================================
# ADMIN APP — local development
# Proxy-bc route forwards to dev.www.bytecrtrs.com (not idlookup.ai)
# This file is copied to .env.local by scripts/admin-env.js
# ============================================================

REACT_APP_NEW_API_ENABLED=true
REACT_APP_NEW_API_URL=https://dev.www.idlookup.ai/api
REACT_APP_NEW_API_CAPTCHA=bcEdgeApiPass

# Proxy via /api/proxy-bc/* → dev.www.bytecrtrs.com
REACT_APP_USE_API_PROXY=true
REACT_APP_PROXY_URL=http://localhost:3001/api/proxy

# Mock API — DISABLED
REACT_APP_USE_MOCK_API=false
REACT_APP_API_URL=

# Feature Flags
REACT_APP_USE_NEW_API_SEARCH=true
REACT_APP_USE_NEW_API_REPORTS=true
REACT_APP_USE_NEW_API_OPTOUT=true
REACT_APP_USE_NEW_API_AUTH=true

# Admin emails
REACT_APP_ADMIN_EMAILS=admin@admin.admin
