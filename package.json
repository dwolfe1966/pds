{
  "name": "idlookup-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.10.0",
    "recharts": "^3.8.0"
  },
  "scripts": {
    "start": "parcel public/index.html --port 3000",
    "build": "parcel build public/index.html --dist-dir build",
    "server": "node server/index.js",
    "tracking": "node tracking-api/index.js",
    "dev": "concurrently \"npm run server\" \"npm run tracking\" \"npm start\"",
    "install-server": "cd server && npm install",
    "install-tracking": "cd tracking-api && npm install",
    "install-admin": "cd admin && npm install",
    "admin": "cd admin && npm start",
    "predeploy": "npm run build",
    "test": "jest --testPathPattern=src/tests",
    "test:watch": "jest --testPathPattern=src/tests --watch",
    "test:coverage": "jest --testPathPattern=src/tests --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/src/__mocks__/styleMock.js"
    },
    "setupFiles": [
      "<rootDir>/src/__mocks__/envMock.js"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.4.0",
    "babel-jest": "^29.7.0",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "parcel": "^2.9.3"
  }
}
