{
  "name": "idlookup-app",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "ws": "8.20.1",
    "shell-quote": "^1.8.4"
  },
  "dependencies": {
    "@zxing/library": "^0.21.3",
    "aamva-parser": "^1.6.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.8.0"
  },
  "scripts": {
    "start": "parcel public/index.html --port 3000 --no-cache",
    "build": "node scripts/clean-build.js build && parcel build public/index.html --dist-dir build --no-source-maps && node scripts/postbuild.js",
    "build:admin": "node scripts/build-admin.js",
    "start:admin": "node scripts/admin-env.js && parcel public/admin.html --port 3003 --no-cache",
    "dev:admin": "concurrently \"npm run server\" \"npm run tracking\" \"npm run start:admin\"",
    "server": "node server/index.js",
    "tracking": "node tracking-api/index.js",
    "dev": "concurrently \"npm run server\" \"npm run tracking\" \"npm start\"",
    "install-server": "cd server && npm install",
    "install-tracking": "cd tracking-api && npm install",
    "install-admin": "cd admin && npm install",
    "admin": "cd admin && npm start",
    "predeploy": "npm run build",
    "test": "jest --testPathPattern=src/tests",
    "test:watch": "jest --testPathPattern=src/tests --watch",
    "test:coverage": "jest --testPathPattern=src/tests --coverage",
    "test:e2e": "playwright test",
    "test:e2e:admin": "playwright test --project=admin",
    "test:e2e:consumer": "playwright test --project=consumer",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|less|scss|sass)$": "<rootDir>/src/__mocks__/styleMock.js",
      "\\.(png|jpg|jpeg|gif|svg|webp)$": "<rootDir>/src/__mocks__/fileMock.js",
      "^react-leaflet$": "<rootDir>/src/__mocks__/reactLeafletMock.js",
      "^leaflet$": "<rootDir>/src/__mocks__/leafletMock.js"
    },
    "setupFiles": [
      "<rootDir>/src/__mocks__/envMock.js"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.4.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "buffer": "^6.0.3",
    "concurrently": "^8.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "parcel": "^2.9.3"
  }
}
