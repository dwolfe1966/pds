# ============================================================
# PRODUCTION ENVIRONMENT — IDLookup.AI
# ============================================================

# ByteCrtrs API
REACT_APP_NEW_API_ENABLED=true
REACT_APP_NEW_API_URL=/api
# Auth goes through the same BC API URL — no separate override needed.
# REACT_APP_AUTH_API_URL=
# BC's password.v0 captcha challenge cannot be auto-solved client-side
# without exposing the dev password in the public bundle. Leave empty in
# committed prod env. If a developer needs autofill while debugging,
# set REACT_APP_NEW_API_CAPTCHA in an untracked .env.local file.
REACT_APP_NEW_API_CAPTCHA=

# Proxy — DISABLED (Option B: direct BC API calls from browser)
# ByteCrtrs must allow CORS from your production domain.
REACT_APP_USE_API_PROXY=false
REACT_APP_PROXY_URL=

# Mock API — DISABLED in production
REACT_APP_USE_MOCK_API=false
REACT_APP_API_URL=

# Feature Flags
# Note: auth, signup, search, reports, and billing are force-routed to BC
# regardless of these flags. These flags only affect non-forced endpoints.
REACT_APP_USE_NEW_API_SEARCH=true
REACT_APP_USE_NEW_API_REPORTS=true
REACT_APP_USE_NEW_API_OPTOUT=true                              # ← Live: BC-hosted opt-out portal handoff (OptOutLandingPage rewrite)
REACT_APP_USE_NEW_API_AUTH=true

# Admin allowlist — comma-separated emails granted admin role on login
# Consumer app does not redirect based on role. Admins access the CSR app directly
# (build-admin / dev.admin.www.bytecrtrs.com). This sentinel email keeps the
# allowlist non-empty but should never match a real user.
REACT_APP_ADMIN_EMAILS=admin@admin.admin

# Email-lead capture endpoint (Vercel + Neon on the SEO app). The BV/v11 mid-loader
# email gate POSTs leads here (src/services/emailCapture.js). Deployed via seo/app/api/leads.
REACT_APP_LEAD_CAPTURE_URL=https://idlookup.me/api/leads

# Tracking API — optional, only needed if deploying the tracking-api service
# REACT_APP_TRACKING_API_URL=https://your-tracking-service.com
# REACT_APP_TRACKING_ADMIN_KEY=                               # ← Only needed for Admin Analytics page

# Google Tag Manager: loaded by the per-brand snippet in public/index.html
# (hostname → container). Do NOT set REACT_APP_GTM_ID — initGtm() is a no-op now;
# setting it previously double-loaded GTM and loaded this DEV container on prod.
