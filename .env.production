# ============================================================
# PRODUCTION ENVIRONMENT — IDLookup.AI
# ============================================================

# ByteCrtrs API
REACT_APP_NEW_API_ENABLED=true
REACT_APP_NEW_API_URL=https://dev1.dev.www.bytecrtrs.com/api  # ← Confirm this is the correct prod URL with ByteCrtrs
REACT_APP_NEW_API_CAPTCHA=bcEdgeApiPass                        # ← Confirm with ByteCrtrs for prod

# Proxy — DISABLED (Option B: direct BC API calls from browser)
# ByteCrtrs must allow CORS from your production domain.
REACT_APP_USE_API_PROXY=false
REACT_APP_PROXY_URL=

# Mock API — DISABLED in production
REACT_APP_USE_MOCK_API=false
REACT_APP_API_URL=

# Feature Flags
# Note: auth, signup, search, reports, and billing are force-routed to BC
# regardless of these flags. These flags only affect non-forced endpoints.
REACT_APP_USE_NEW_API_SEARCH=true
REACT_APP_USE_NEW_API_REPORTS=true
REACT_APP_USE_NEW_API_OPTOUT=false                             # ← Enable when opt-out flow verified in prod
REACT_APP_USE_NEW_API_AUTH=true

# Admin allowlist — comma-separated emails granted admin role on login
REACT_APP_ADMIN_EMAILS=admin@admin.admin                       # ← Replace with real admin email(s) before go-live

# Tracking API — optional, only needed if deploying the tracking-api service
# REACT_APP_TRACKING_API_URL=https://your-tracking-service.com
# REACT_APP_TRACKING_ADMIN_KEY=                               # ← Only needed for Admin Analytics page
